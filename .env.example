NEXT_PUBLIC_SITE_URL=https://skillsair.com
SKILLSAIR_BACKEND_URL=https://kiwi.skillsair.com
# Server-only shared secret (32+ chars); must equal BFF_SHARED_SECRET on the backend so rate
# limits apply per visitor rather than to this server. Never prefix with NEXT_PUBLIC_.
BFF_SHARED_SECRET=
# Optional analytics IDs; nothing loads while these are unset, and only after cookie consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_FEATURE_LAPTOP_SUPPORT=true
